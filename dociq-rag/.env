# Copy this file to .env and fill in real values. Never commit .env.

# If using the local mongo service from docker-compose.yml, leave this as-is.
# If using MongoDB Atlas (or another hosted Mongo), replace with that URI
# and remove the "mongo" service + depends_on from docker-compose.yml.
MONGO_URI=mongodb://localhost:27018

GROQ_API_KEY=USE_YOUR_OWN_GROQ_API